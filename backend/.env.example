DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,.railway.app,.up.railway.app,.onrender.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storytelling
# Optional DB fallback parts when DATABASE_URL is not set.
DB_NAME=storytelling
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=false
# Railway also exposes PGDATABASE, PGUSER, PGPASSWORD, PGHOST, PGPORT.
# Render web services expose RENDER_EXTERNAL_HOSTNAME and can use Render Postgres DATABASE_URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
RUN_MIGRATIONS_ON_START=true
API_PAGE_SIZE=20
THROTTLE_ANON=100/hour
THROTTLE_USER=600/hour
THROTTLE_AUTH=30/hour
THROTTLE_TRANSLATION=60/hour
ENABLE_GOOGLE_TRANSLATE_PROXY=true
SUPPORTED_TRANSLATION_LANGUAGES=en,hi
ENABLE_DEMO_LOGIN_USERS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
